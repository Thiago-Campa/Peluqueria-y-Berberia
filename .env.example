# Copiá este archivo como .env y completalo. El .env NO se sube a GitHub.
# Cadena de conexión de Neon (botón "Connect" en neon.tech, con Connection pooling activado)
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require
# Contraseña para entrar al panel /#/admin
ADMIN_PASSWORD=admincampa
# Clave larga y secreta para firmar la sesión del admin (inventá una)
ADMIN_SECRET=admincampakey

# Correo de confirmación de turnos (Gmail con "contraseña de aplicación", ver README)
MAIL_USER=tucorreo@gmail.com
MAIL_PASS=abcdefghijklmnop
MAIL_NOMBRE=Tu Peluquería

# Mercado Pago (cobro de la seña). Es el "Access Token" de la cuenta de Mercado Pago donde querés recibir la plata.
# Sin esto no se cobra nada y los turnos se confirman directo.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Dirección pública del sitio (en Vercel se detecta sola; en tu compu queda http://localhost:5173)
BASE_URL=https://tu-sitio.vercel.app
